# Connection string do PostgreSQL usado pelo Prisma.
# Combina com o serviço `postgres` do docker-compose.yml (usuário/senha "docker").
DATABASE_URL="postgresql://docker:docker@localhost:5432/forenser?schema=public"

# Segredo usado para assinar e validar os tokens JWT emitidos em /auth/login.
# Gere um valor longo e aleatório em produção, por exemplo: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret"

# Validade do token JWT (formato aceito pela lib `ms`: "1h", "7d", "30m", ...).
JWT_EXPIRES_IN="1h"

# Chave da API da OpenAI usada para gerar os retratos falados com o modelo dall-e-3.
# Crie a sua em https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Porta em que a API HTTP escuta.
PORT=3001

# Origem(ns) do frontend autorizadas a chamar a API via CORS, separadas por vírgula.
# Se omitido, a API libera qualquer origem (não recomendado em produção).
CORS_ORIGIN="http://localhost:3000"
